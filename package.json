{
  "name": "duepilot",
  "version": "0.1.0",
  "description": "AI collections agent for freelancers: natural-language PayPal invoicing with human approval, webhooks and audit log.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
