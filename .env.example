# Leave PAYPAL_CLIENT_ID empty to run in keyless DEMO MODE.
PORT=3000
# PayPal sandbox app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Email of your sandbox BUSINESS account (the invoicer)
PAYPAL_INVOICER_EMAIL=
# Webhook ID shown after you add a webhook in the sandbox app (needed for signature verification)
PAYPAL_WEBHOOK_ID=
# AI provider: gemini | demo   (demo = keyless rule-based parser)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Used automatically when the main model is rate-limited or overloaded
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Guardrail: invoices above this amount are refused
MAX_INVOICE_AMOUNT=5000
MAX_PAYOUT_AMOUNT=500
